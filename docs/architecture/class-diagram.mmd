flowchart LR
    User["User<br/>«Business Actor»"]

    subgraph Browser["Client (browser, static/js)"]
        App["«Application Component»<br/>BoardApp<br/>executeRemote(label, op)<br/>canEdit()"]
        ApiClient["«Application Component»<br/>BoardApiClient<br/>create(name)<br/>load(id)<br/>save(board)"]
        State["«Application Component»<br/>BoardState<br/>selectedId, interaction, remote<br/>move() / beginConnect() / completeConnect()<br/>removeSelected() / toPersistedBoard()"]
        View["«Application Component»<br/>BoardView<br/>render(snapshot)<br/>on(handlers)"]
    end

    subgraph Web["Web layer (infrastructure.web.rest)"]
        Controller["«Application Component»<br/>BoardRestController<br/>create() / get() / replace()"]
        ErrorHandler["«Application Component»<br/>GlobalExceptionHandler<br/>uniform ApiError mapping"]
    end

    subgraph AppLayer["Application layer"]
        Service["«Application Component»<br/>BoardApplicationService<br/>createBoard() / getBoard() / replaceBoard()"]
        Port["«Application Interface»<br/>BoardRepository<br/>save() / findById() / existsById()"]
    end

    subgraph Infra["Persistence adapter (infrastructure.persistence)"]
        Adapter["«Application Component»<br/>InMemoryBoardRepository"]
        Store[("«Data Object»<br/>In-memory board map")]
    end

    subgraph Domain["Domain model"]
        BoardD["«Data Object»<br/>Board<br/>id, name, elements"]
        ElementD["«Data Object»<br/>BoardElement<br/>id, type, x, y, width, height, text, sourceId, targetId"]
        TypeD["«Data Object»<br/>ElementType<br/>RECTANGLE / TEXT / CONNECTOR"]
    end

    User -->|"interacts with"| App
    App -->|"reads/updates"| State
    App -->|"render(snapshot)"| View
    View -.->|"flow: select/move/connectTarget"| App
    App -->|"create/load/save"| ApiClient
    ApiClient -->|"triggering: POST/GET/PUT /api/boards"| Controller
    Controller -->|"triggering"| Service
    Controller -.->|"flow: exceptions"| ErrorHandler
    Service -->|"serving"| Port
    Adapter -.->|"realizes"| Port
    Adapter -->|"accesses"| Store
    State -->|"holds"| BoardD
    Service -->|"accesses"| BoardD
    BoardD -->|"composition: 0..* elements"| ElementD
    ElementD -->|"accesses"| TypeD
