classDiagram
    direction LR

    class BoardRestController {
        -BoardApplicationService service
        +create(CreateBoardRequest) ResponseEntity~Board~
        +get(String) Board
        +replace(String, ReplaceBoardRequest) Board
    }

    class BoardApplicationService {
        -BoardRepository repository
        +createBoard(String) Board
        +getBoard(String) Board
        +replaceBoard(String, String, List~BoardElement~) Board
    }

    class BoardRepository {
        <<interface>>
        +save(Board) Board
        +findById(String) Optional~Board~
        +existsById(String) boolean
    }

    class InMemoryBoardRepository {
        -Map~String, Board~ boards
    }

    class Board {
        +String id
        +String name
        +List~BoardElement~ elements
    }

    class BoardElement {
        +String id
        +ElementType type
        +double x
        +double y
        +double width
        +double height
        +String text
        +String sourceId
        +String targetId
    }

    class ElementType {
        <<enumeration>>
        RECTANGLE
        TEXT
        CONNECTOR
    }

    class BoardApp {
        -BoardApiClient apiClient
        -BoardState state
        -BoardView view
        +executeRemote(String, Function) void
        +canEdit() boolean
    }

    class BoardApiClient {
        +create(String) Board
        +load(String) Board
        +save(Board) Board
    }

    class BoardState {
        -Board board
        -String selectedId
        -Interaction interaction
        -RemoteStatus remote
        +snapshot() Snapshot
        +move(String, double, double) void
        +beginConnect() void
        +completeConnect(String) BoardElement
        +removeSelected() void
        +toPersistedBoard() Board
    }

    class BoardView {
        -Snapshot rendered
        +render(Snapshot) void
        +on(Handlers) void
    }

    BoardRestController --> BoardApplicationService : delegates to
    BoardApplicationService --> BoardRepository : uses
    InMemoryBoardRepository ..|> BoardRepository : implements
    BoardApplicationService --> Board : creates/returns
    BoardRepository --> Board : persists
    Board "1" *-- "0..*" BoardElement : elements
    BoardElement --> ElementType : type

    BoardApp --> BoardApiClient : create/load/save
    BoardApp --> BoardState : reads/updates
    BoardApp --> BoardView : render(snapshot)
    BoardView --> BoardApp : select/move/connectTarget
    BoardApiClient --> BoardRestController : POST/GET/PUT /api/boards
    BoardState "1" *-- "1" Board : holds
