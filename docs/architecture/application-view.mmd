flowchart LR
    User["User<br/>browser"]

    subgraph Browser["Client (browser, static/js)"]
        App["BoardApp<br/>app.js — coordinates events/use cases"]
        ApiClient["BoardApiClient<br/>api/board-api-client.js — only fetch caller"]
        State["BoardState<br/>state/board-state.js — Board, selection, connect mode"]
        View["BoardView<br/>ui/board-view.js — SVG projection"]
    end

    subgraph Web["Web layer (infrastructure.web.rest)"]
        Controller["BoardRestController<br/>REST interface"]
        ErrorHandler["GlobalExceptionHandler<br/>uniform ApiError mapping"]
    end

    subgraph App2["Application layer"]
        Service["BoardApplicationService<br/>create / get / replace use cases"]
        Port["BoardRepository<br/>&lt;&lt;port&gt;&gt;"]
    end

    subgraph Infra["Persistence adapter (infrastructure.persistence)"]
        Adapter["InMemoryBoardRepository"]
        Store[("In-memory board map")]
    end

    User -->|"interacts with"| App
    App -->|"reads/updates"| State
    App -->|"render(snapshot)"| View
    View -.->|"select/move/connectTarget"| App
    View -->|"projects onto"| DOM["SVG canvas"]
    App -->|"create/load/save"| ApiClient
    ApiClient -->|"POST/GET/PUT /api/boards"| Controller
    Controller -->|"delegates use case"| Service
    Controller -.->|"exceptions"| ErrorHandler
    Service -->|"depends on abstraction"| Port
    Adapter -->|"implements"| Port
    Adapter -->|"reads/writes"| Store
